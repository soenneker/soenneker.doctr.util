<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <UseLocalPythonUtil Condition="'$(UseLocalPythonUtil)' == '' and Exists('..\..\..\..\Python\soenneker.python.util\src\Soenneker.Python.Util\Soenneker.Python.Util.csproj')">true</UseLocalPythonUtil>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A cross-platform docTR OCR utility for .NET using Python.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.DocTr.Util</AssemblyName>
        <PackageId>Soenneker.DocTr.Util</PackageId>
        <PackageTags>doctr util ocr python documents recognition doctrutil csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.doctr.util</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.doctr.util</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Soenneker.Asyncs.Semaphores" Version="4.0.16" />
        <PackageReference Include="Soenneker.Atomics.ValueBools" Version="4.0.45" />
        <PackageReference Include="Soenneker.Python.Util" Version="4.0.440" Condition="'$(UseLocalPythonUtil)' != 'true'" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\doctr_worker.py" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalPythonUtil)' == 'true'">
        <ProjectReference Include="..\..\..\..\Python\soenneker.python.util\src\Soenneker.Python.Util\Soenneker.Python.Util.csproj" />
    </ItemGroup>
</Project>
